# AitMate Environment Configuration (Template)
# Copy this file to .env for local development. Never commit .env or secrets to Git.

# Local Backend API Configuration
AITMATE_BACKEND_HOST=127.0.0.1
AITMATE_BACKEND_PORT=8000
AITMATE_DEBUG=false

# Authentication Boundary (Generated automatically if not set)
# AITMATE_API_TOKEN=your-random-session-token-here

# Local Database
AITMATE_DATABASE_URL=sqlite:///./aitmate.db

# AI Provider Configuration
# Supported: groq, ollama, mock
AITMATE_AI_PROVIDER=groq

# Groq LPU Configuration (Recommended for ultra-fast inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
AITMATE_GROQ_MODEL=openai/gpt-oss-120b
AITMATE_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama Local Configuration (Optional alternative)
AITMATE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AITMATE_OLLAMA_MODEL=llama3.2:latest

# Security & Policies
AITMATE_BROWSER_HEADLESS=false
AITMATE_ALLOWED_DOMAINS=wikipedia.org,github.com,gitlab.com,python.org
AITMATE_AUDIT_LOG_PATH=./aitmate_audit.log
